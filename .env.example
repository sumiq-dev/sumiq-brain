# Copy to .env and fill in. Never commit .env.

# Access token: clients send it as "Authorization: Bearer <token>". Either keep it in KeePassXC and
# start with ./docker/up.sh (recommended; then leave BRAIN_TOKEN empty), or set it here
# (generate one with: openssl rand -hex 32).
KEEPASS_DB=
KEEPASS_ENTRY=AI Brain
BRAIN_TOKEN=

# Host port and the user that owns ./data on the host (run `id -u` / `id -g`).
BRAIN_PORT=8765
PUID=1000
PGID=1000

# Web UI for chatting with agents: http://localhost:${HARNESS_PORT} (only reachable from this machine).
HARNESS_PORT=3000
BRAIN_HARNESS=true

# The librarian files documents dropped into data/vault/inbox automatically (true/false).
BRAIN_WATCH=true

# Optional, depending on the providers you use:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Claude subscription without an interactive login: run `claude setup-token` and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
