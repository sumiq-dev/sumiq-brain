# Copy to .env and fill in. Never commit .env.

# Required: clients must send this as "Authorization: Bearer <token>". Generate one with: openssl rand -hex 32
BRAIN_TOKEN=

# Host port and the user that owns ./data on the host (run `id -u` / `id -g`).
BRAIN_PORT=8765
PUID=1000
PGID=1000

# The librarian files documents dropped into data/vault/inbox automatically (true/false).
BRAIN_WATCH=true

# Optional, depending on the providers you use:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Claude subscription without an interactive login: run `claude setup-token` and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
