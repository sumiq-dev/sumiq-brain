# Brain data never belongs in this repo. Everything at the top level is ignored unless listed
# below, so a vault created anywhere in the repo (data/, my-brain/, ...) can't be committed.
/*
!/.gitignore
!/.dockerignore
!/.env.example
!/Dockerfile
!/docker-compose.yml
!/README.md
!/pyproject.toml
!/aibrain/
!/docker/
!/docs/
!/tests/
!/web/

# Inside allowed folders
__pycache__/
*.egg-info/
.pytest_cache/
**/brain.yaml
**/.brain/
